    {% set cs = inf.get('climate_shock') or {} %}
    {% set raw_crop = (inf.get('crop_type_affected') or inf.get('crop_name_id') or inf.get('infestation_crop_name_id') or '') | lower %}
    {% set crop_val = crop_map.get(raw_crop, inf.get('crop_type_affected') or inf.get('crop_name_id') or inf.get('infestation_crop_name_id') or '') %}
    {% set raw_cs = (inf.get('cluster_status_id') or '') | lower %}
    {% set cs_val = inf_cluster_map.get(raw_cs, (inf.get('cluster_status_id') or '') | upper) %}
    {% set raw_itypes = (inf.get('infestation_type_ids') or '').split(' ') %}
    {% set itype_vals = [] %}
    {% for it in raw_itypes %}
      {% set it_clean = it | trim | lower %}
      {% if it_clean %}
        {% set mapped_it = inf_type_map.get(it_clean, it_clean | upper) %}
        {% set _ = itype_vals.append(mapped_it) %}
      {% endif %}
    {% endfor %}
    {% set itype_val = itype_vals | join(',') %}
    {% set raw_dtype = (dis.get('disease_type') or '') | lower %}
    {% set dtype_val = disease_type_map.get(raw_dtype, (dis.get('disease_type') or '') | upper) %}
    {
      "land_id": "{{ inf.get('infestation_land_info_id') or '' }}",
      "commodity": "{{ crop_val }}",
      "cluster_name": "{{ inf.get('fpc_name') or inf.get('infestation_fpc_name') or inf.get('cluster_name') or '' }}",
      "growth_stage": "{{ (inf.get('growth_stage') or '') | upper }}",
      "cluster_status": "{{ cs_val }}",
      "infestation_type": "{{ itype_val }}",
      "severity_level": "{{ (inf.get('security_level') or inf.get('severity_level') or 'low') | upper }}",
      "estimated_damage_pct": {{ (inf.get('estimated_damage') or 0) | float }},
      "observation_date": "{{ inf.get('observation_date') or sub_dt }}",
      "observation_date_ec": "{{ inf.get('ec_date_message') or '' }}",
      "pest_type": "{{ po.get('pest_type') or '' }}",
      "pest_name": "{{ po.get('pest_name') or '' }}",
      "pesticide_method": "{{ po.get('pest_pesticide_method') or '' }}",
      "pesticide_type": "{{ po.get('pesticide_type') or '' }}",
      "pesticide_name": "{{ po.get('pesticide_name') or '' }}",
      "pesticide_frequency": "{{ po.get('pest_frequency_of_application') or po.get('pest_pesticide_frequency') or '' }}",
      "weed_type": "{{ wo.get('weed_type') or '' }}",
      "weed_name": "{{ wo.get('weed_name_id') or '' }}",
      "weed_control_method": "{{ wo.get('pesticide_method') or '' }}",
      "weedicide_type": "{{ wo.get('weedicide_type') or '' }}",
      "weedicide_name": "{{ wo.get('weedicide_name') or '' }}",
      "weedicide_frequency": "{{ wo.get('weed_frequency_of_application') or wo.get('weedicide_frequency') or '' }}",
      "disease_type": "{{ dtype_val }}",
      "disease_name": "{{ dis.get('disease_name') or '' }}",
      "disease_control_method": "{{ dis.get('ind_method_of_control') or '' }}",
      "fungicide_type": "{{ dis.get('fungicide_type') or '' }}",
      "fungicide_name": "{{ dis.get('fungicide_name') or '' }}",
      "disease_frequency_of_application": "{{ dis.get('disease_frequency_of_application') or '' }}",
      "nutrient_type": "{{ nd.get('nutrient_type') or '' }}",
      "nutrient_name": "{{ nd.get('nutrient_name') or '' }}",
      "nutrient_control_method": "{{ nd.get('method_of_control') or nd.get('nutrient_method_of_control') or '' }}",
      "nutrient_fertilizer_type": "{{ nd.get('fertilizer_type') or '' }}",
      "nutrient_fertilizer_name": "{{ nd.get('fertilizer_name') or '' }}",
      "nutrient_frequency_of_application": "{{ nd.get('nutrient_frequency_of_application') or '' }}",
      "shock_type": "{{ cs.get('shock_type') or '' }}",
      "shock_event_name": "{{ cs.get('shock_event_name') or '' }}",
      "climate_control_method": "{{ cs.get('method_of_control') or cs.get('climate_method_of_control') or '' }}",
      "recovery_input_type": "{{ cs.get('recovery_input_type') or '' }}",
      "recovery_input_name": "{{ cs.get('recovery_input_name') or '' }}",
      "climate_frequency_of_application": "{{ cs.get('climate_frequency_of_application') or cs.get('nutrient_frequency_of_application') or '' }}"
    }{% if not loop.last %},{% endif %}
  {% endfor %}
  ]
{% elif is_harvest %}
  {% set h_raw = d.get('harvesting') %}
  {% set h_list = h_raw if (h_raw is iterable and h_raw is not mapping and h_raw is not string) else ([h_raw] if h_raw else [{}]) %}
  {% set raw_s = (farmer_id.get('production_season') or 'belg') | lower %}
  {% set harvest_season = season_map.get(raw_s, 'CROP_SEASON_' ~ (raw_s | upper)) %}
  "cs_common_intake_record": [
    {
      "farmer_name": "{{ farmer_name_val }}",
      "fayda_fan_id": "{{ fayda_id }}",
      "crop_year": "{{ crop_year }}",
      "production_season": "{{ harvest_season }}",
      "region": "{{ reg_val }}",
      "region_name": "{{ reg_name }}",
      "zone": "{{ zone_val }}",
      "zone_name": "{{ raw_zone }}",
      "woreda": "{{ woreda_val }}",
      "woreda_name": "{{ raw_woreda }}",
      "kebele": "{{ kebele_val }}",
      "kebele_name": "{{ raw_kebele }}",
      "status": "DRAFT",
      "lifecycle_stage": "HARVESTING"
    }
  ],
  "cs_harvest_details": [
  {% for h in h_list %}
    {% set ih_info = h.get('independant_details') if h.get('independant_details') else (d.get('independant_harvest') or {}) %}
    {% set cl_info = h.get('clustered_details') or {} %}
    {% set sp = h if h.get('surveyor_name') else (d.get('survey_personnel') or {}) %}
    {% set h_land_id = h.get('land_info_id') or '' %}
    {% set raw_cs = (h.get('cluster_status_ids') or '') | lower %}
    {% set has_cl = ('cluster' in raw_cs) %}
    {% set has_ind = ('independent' in raw_cs) %}
    {% if has_cl and has_ind %}
      {% set cs_json = '["CLUSTER", "INDEPENDENT"]' %}
    {% elif has_cl %}
      {% set cs_json = '["CLUSTER"]' %}
    {% elif has_ind %}
      {% set cs_json = '["INDEPENDENT"]' %}
    {% else %}
      {% set cs_json = '[]' %}
    {% endif %}
    {% set h_maturity = ((ih_info.get('independent_crop_maturity_status') or ih_info.get('crop_maturity_status') or 'READY_FOR_HARVEST') | upper) if has_ind else '' %}
    {% set h_date = (ih_info.get('independent_harvest_date') or ih_info.get('harvest_date') or (sub_dt if has_ind else '')) if has_ind else '' %}
    {% set raw_h_area = (ih_info.get('independent_area_harvested') if ih_info.get('independent_area_harvested') is not none else (ih_info.get('area_harvested') if ih_info.get('area_harvested') is not none else (cl_info.get('area_harvested') if cl_info.get('area_harvested') is not none else cl_info.get('cluster_area_harvested')))) if has_ind else 0.0 %}
    {% set h_area = (raw_h_area | float) if (has_ind and raw_h_area is not none and raw_h_area) else (1.0 if has_ind else 0.0) %}
    {% if has_ind and h_area <= 0 %}{% set h_area = 1.0 %}{% endif %}
    {% set h_qty = ((ih_info.get('independent_qty_harvested') or ih_info.get('qty_harvested') or cl_info.get('qty_harvested') or cl_info.get('cluster_qty_harvested') or 0.0) | float) if has_ind else 0.0 %}
    {% set loss_pct = ((ih_info.get('independent_post_harvest_loss_pct') or ih_info.get('post_harvest_loss_pct') or cl_info.get('post_harvest_loss_pct') or cl_info.get('cluster_post_harvest_loss_pct') or 0.0) | float) if has_ind else 0.0 %}
    {% if loss_pct < 0 %}{% set loss_pct = 0.0 %}{% endif %}
    {% if loss_pct > 100 %}{% set loss_pct = 100.0 %}{% endif %}
    {% set s_qty = ((ih_info.get('independent_qty_stored') or ih_info.get('qty_stored') or cl_info.get('qty_stored') or cl_info.get('cluster_qty_stored') or 0.0) | float) if has_ind else 0.0 %}
    {% set sold_qty = ((ih_info.get('independent_qty_sold') or ih_info.get('qty_sold') or cl_info.get('qty_sold') or cl_info.get('cluster_qty_sold') or 0.0) | float) if has_ind else 0.0 %}
    {% if (s_qty + sold_qty) > h_qty and h_qty > 0 %}
      {% if s_qty <= h_qty %}
        {% set sold_qty = h_qty - s_qty %}
      {% else %}
        {% set s_qty = h_qty %}
        {% set sold_qty = 0.0 %}
      {% endif %}
    {% elif h_qty <= 0 %}
      {% set s_qty = 0.0 %}
      {% set sold_qty = 0.0 %}
    {% endif %}
    {% set cl_maturity = ((cl_info.get('crop_maturity_status') or cl_info.get('cluster_crop_maturity_status') or 'READY_FOR_HARVEST') | upper) if has_cl else '' %}
    {% set cl_date = (cl_info.get('harvest_date') or cl_info.get('cluster_harvest_date') or (sub_dt if has_cl else '')) if has_cl else '' %}
    {% set cl_area = (((cl_info.get('area_harvested') if cl_info.get('area_harvested') is not none else cl_info.get('cluster_area_harvested')) or 0.0) | float) if has_cl else 0.0 %}
    {% set cl_qty = (((cl_info.get('qty_harvested') if cl_info.get('qty_harvested') is not none else cl_info.get('cluster_qty_harvested')) or 0.0) | float) if has_cl else 0.0 %}
    {% set cl_loss_pct = (((cl_info.get('post_harvest_loss_pct') if cl_info.get('post_harvest_loss_pct') is not none else cl_info.get('cluster_post_harvest_loss_pct')) or 0.0) | float) if has_cl else 0.0 %}
    {% set cl_s_qty = (((cl_info.get('qty_stored') if cl_info.get('qty_stored') is not none else cl_info.get('cluster_qty_stored')) or 0.0) | float) if has_cl else 0.0 %}
    {% set cl_sold_qty = (((cl_info.get('qty_sold') if cl_info.get('qty_sold') is not none else cl_info.get('cluster_qty_sold')) or 0.0) | float) if has_cl else 0.0 %}
    {% set raw_h_crop = (ih_info.get('actual_crop_name') or ih_info.get('crop_name_id') or cl_info.get('actual_crop_name') or cl_info.get('crop_name_id') or h.get('commodity') or '') | lower %}
    {% set h_crop_val = crop_map.get(raw_h_crop, ih_info.get('actual_crop_name') or ih_info.get('crop_name_id') or cl_info.get('actual_crop_name') or cl_info.get('crop_name_id') or h.get('commodity') or '') %}
    {% set cl_fpc = cl_info.get('cluster_fpc_name') or cl_info.get('fpc_name') or cl_info.get('cluster_name') or '' %}
    {
      "land_id": "{{ h_land_id }}",
      "cluster_status": {{ cs_json }},
      "cluster_name": "{{ cl_fpc }}",
      "commodity": "{{ h_crop_val }}",
      "crop_maturity_status": "{{ h_maturity }}",
      "harvest_date": "{{ h_date }}",
      "harvest_date_ec": "{{ ih_info.get('harvest_date_ec') or '' }}",
      "area_harvested": {{ h_area }},
      "qty_harvested": {{ h_qty }},
      "post_harvest_loss_pct": {{ loss_pct }},
      "qty_stored": {{ s_qty }},
      "qty_sold": {{ sold_qty }},
      "cluster_crop_maturity_status": "{{ cl_maturity }}",
      "cluster_harvest_date": "{{ cl_date }}",
      "cluster_area_harvested": {{ cl_area }},
      "cluster_qty_harvested": {{ cl_qty }},
      "cluster_post_harvest_loss_pct": {{ cl_loss_pct }},
      "cluster_qty_stored": {{ cl_s_qty }},
      "cluster_qty_sold": {{ cl_sold_qty }},
      "da_name": "{{ sp.get('surveyor_name') or '' }}",
      "da_mobile_number": "{{ sp.get('surveyor_mobile_number') or '' }}",
      "supervisor_name": "{{ sp.get('supervisor_name') or '' }}",
      "supervisor_mobile_number": "{{ sp.get('supervisor_mobile_number') or '' }}"
    }{% if not loop.last %},{% endif %}
  {% endfor %}
  ]
{% endif %}
}
